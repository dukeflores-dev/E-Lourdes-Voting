# Environment Variables for E-Voting System
# Copy this file to .env and fill in your values

PORT=3000

# Session secret - change this to a long random string in production
SESSION_SECRET=lourdes-evoting-super-secret-key-2024

# Email Configuration (Nodemailer)
# For Gmail: use your Gmail address and an App Password (not your regular password)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Lourdes College E-Voting <your-email@gmail.com>"

# Institution Name (shown in the UI)
INSTITUTION_NAME=Lourdes College
